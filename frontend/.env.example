# Set this in the frontend hosting service before building.
# It must end in /api. This is a public URL, never a credential.
VITE_API_BASE_URL=https://YOUR-BACKEND-HOST/api

# Firebase browser configuration is public. Never put an Admin private key here.
# Set all values from the SAME Firebase web app before rebuilding Vercel.
VITE_IDENTITY_PROVIDER=firebase
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
VITE_FIREBASE_PROJECT_ID=accey-demo
VITE_FIREBASE_AUTH_DOMAIN=accey-demo.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=accey-demo.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=1090447780261
VITE_FIREBASE_APP_ID=1:1090447780261:web:b2a336d19a43b3086be04c
