# Configure these in the backend host's encrypted environment settings.
ACCESSLY_PUBLIC_MODE=1
ACCESSLY_DATA_DIR=/var/data/accessly
ACCESSLY_ALLOWED_ORIGINS=https://YOUR-FRONTEND-HOST
STRANDS_BROWSER_HEADLESS=true
AWS_REGION=
AWS_BEARER_TOKEN_BEDROCK=
ACCESSLY_EMAIL=
ACCESSLY_EMAIL_APP_PASSWORD=
ACCESSLY_TEST_RECIPIENT=
ACCESSLY_DAILY_ACTION_LIMIT=60
ACCESSLY_VISITOR_DAILY_LIMIT=12

# Database/auth. PostgreSQL schema is applied separately, never at app startup.
DATABASE_URL=
# At least 32 random characters; signs JWTs and hashes one-time codes.
JWT_SECRET=
# Only required when running the agent directly instead of through the API.
# DEFAULT_USER_ID=
# Existing research integration remains required.
FIRECRAWL_API_KEY=

# Firebase is opt-in; keep postgres until the separate cutover is approved.
ACCESSLY_IDENTITY_PROVIDER=postgres
FIREBASE_PROJECT_ID=accey-80215
# Absolute path to a mounted secret; never copy the JSON into an image or Git.
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-admin.json
# DEFAULT_FIREBASE_UID=  # only for direct main.py CLI use in Firebase mode
# Browser configuration (Vite reads frontend/.env.local or exported build env):
# VITE_IDENTITY_PROVIDER=firebase
# VITE_FIREBASE_AUTH_CONTINUE_URL=http://localhost:8443/
# Emulators ONLY in isolated local tests; never set these in production:
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8089
# VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
