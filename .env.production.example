# Configure these in the backend host's encrypted environment settings.
ACCESSLY_PUBLIC_MODE=1
ACCESSLY_DATA_DIR=/var/data/accessly
ACCESSLY_ALLOWED_ORIGINS=https://YOUR-FRONTEND-HOST
STRANDS_BROWSER_HEADLESS=true
AWS_REGION=
AWS_BEARER_TOKEN_BEDROCK=
ACCESSLY_EMAIL=
ACCESSLY_EMAIL_APP_PASSWORD=
ACCESSLY_TEST_RECIPIENT=
ACCESSLY_DAILY_ACTION_LIMIT=60
ACCESSLY_VISITOR_DAILY_LIMIT=12
